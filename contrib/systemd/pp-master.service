[Unit]
Description=pumpkinPie master (UI + API + gRPC + reverse proxy)
Documentation=https://github.com/pumpkinpie/pumpkinpie
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pp
Group=pp
# Adjust the YAML config to your environment; every knob (listen
# addresses, SQLite path, optional GreptimeDB sink) lives there.
ExecStart=/usr/local/bin/pp master --config=/etc/pp/pp-master.yaml
WorkingDirectory=/var/lib/pp

# Hardening: drop privileges and isolate the process as much as possible
# without breaking the SQLite + Docker-proxy functionality.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtimeScheduling=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# Restart policy
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pp-master

[Install]
WantedBy=multi-user.target
